<?xml version="1.0" encoding="UTF-8"?>
<!--
  IIS application "__APP_PATH__" (Default Web Site) - a reverse proxy only, no
  files are served from here.  "0. install.bat" copies this file to
  C:\inetpub\icb-election\web.config with the __TOKENS__ filled in.

    http://<server-ip>__APP_PATH__/api/...   ->  FastAPI   http://127.0.0.1:__API_PORT__/api/...
    http://<server-ip>__APP_PATH__/...       ->  Next.js   http://127.0.0.1:__UI_PORT____APP_PATH__/...
    http://<server-ip>__APP_PATH__           ->  redirect to the live screen

  Needs the IIS "URL Rewrite" and "Application Request Routing" modules (ARR
  proxy enabled, response buffer 0 so the live screen's event stream is not
  held back) - "0. install.bat" sets both up.
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <clear />
        <rule name="ICB election - landing page" stopProcessing="true">
          <match url="^$" />
          <action type="Redirect" url="__APP_PATH__/dashboard" redirectType="Found" />
        </rule>
        <!-- {UNENCODED_URL} keeps the path exactly as the browser sent it (and the query string). -->
        <rule name="ICB election - API" stopProcessing="true">
          <match url="^api/" />
          <conditions>
            <add input="{UNENCODED_URL}" pattern="^__APP_PATH__(/api/.*)$" />
          </conditions>
          <action type="Rewrite" url="http://127.0.0.1:__API_PORT__{C:1}" appendQueryString="false" />
        </rule>
        <rule name="ICB election - UI" stopProcessing="true">
          <match url=".*" />
          <conditions>
            <add input="{UNENCODED_URL}" pattern="^(__APP_PATH__.*)$" />
          </conditions>
          <action type="Rewrite" url="http://127.0.0.1:__UI_PORT__{C:1}" appendQueryString="false" />
        </rule>
      </rules>
    </rewrite>
    <!-- Compression would buffer the live screen's event stream (text/event-stream). -->
    <urlCompression doStaticCompression="false" doDynamicCompression="false" />
    <httpErrors existingResponse="PassThrough" />
  </system.webServer>
</configuration>
