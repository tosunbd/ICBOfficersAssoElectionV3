# ICB Officers' Association Election System — configuration
# Copy this file to `.env` (same folder) and adjust.  Both the local run and
# docker-compose read it.  Relative paths are relative to this folder.

# ---------------------------------------------------------------- Security
# Change this on the real server (any long random string).
JWT_SECRET_KEY=change-me-to-a-long-random-string

# First admin account, created on first start only.  Change the password
# afterwards in Admin -> Settings.
ADMIN_DEFAULT_USERNAME=admin
ADMIN_DEFAULT_PASSWORD=admin123

# ------------------------------------------------------------------ Folders
# Where the scanner drops files, and where processed files are moved to.
# On a server these can point to a shared network folder, e.g.
#   SCANNED_FOLDER_PATH=D:/ElectionScans/Scanned
SCANNED_FOLDER_PATH=./data/Scanned
COMPLETED_FOLDER_PATH=./data/Completed
FAILED_FOLDER_PATH=./data/Failed
PREVIEW_FOLDER_PATH=./data/Previews

# SQLite database file (local run).  docker-compose overrides this.
# {Year} is replaced by the election year: one database file per election
# (data/icbOfficerAssoDB2026.db, ...), kept afterwards as the record of that
# election.  The year is normally chosen in Admin -> Settings -> Database;
# ELECTION_YEAR is only the starting value (0 = the current year).
DATABASE_URL=sqlite+aiosqlite:///./data/icbOfficerAssoDB{Year}.db
ELECTION_YEAR=0

# --------------------------------------------------- Automatic processing
AUTO_PROCESS_ENABLED=true     # watch the Scanned folder
SCAN_POLL_INTERVAL=5          # seconds between folder sweeps
FILE_STABLE_SECONDS=1.5       # wait for the scanner to finish writing
PROCESS_DELAY_SECONDS=0       # pause between files; set 2 to watch results appear one by one

# ------------------------------------------------------- Mark detection
OCR_DPI=200                   # render resolution for PDF pages (150-300)
BALLOT_COLUMNS=2              # candidates printed side by side per row
MARK_THRESHOLD=0.06           # ink ratio inside a box that counts as marked
LOW_CONFIDENCE_THRESHOLD=0.65 # below this a ballot is flagged "needs review"

# --------------------------------------------------------------- Network
# Origins allowed to call the API.  "*" is fine on a private LAN.
CORS_ORIGINS=*
# Host ports used by docker-compose
API_PORT=8000
UI_PORT=3000
# Optional fixed API URL baked into the UI at build time.  Leave empty: the
# browser then calls http://<same host as the page>:8000 automatically.
NEXT_PUBLIC_API_URL=
# URL prefix of the UI when it is published through IIS on port 80, e.g.
#   http://192.168.15.57/election/admin  and  /election/dashboard
# Set by "0. install.bat" (keep it in step with IIS_APP_PATH in "0. install.bat").  The UI
# is rebuilt automatically by "1. Start.bat" when this changes.  Leave empty to
# serve the UI from the root of http://<host>:3000 instead.
NEXT_PUBLIC_BASE_PATH=/election

# Seconds between full dashboard refreshes (changes are pushed instantly anyway)
SSE_REFRESH_INTERVAL=2
LIVE_BALLOT_DISPLAY_SECONDS=2   # default seconds between live-screen updates for a new election (change it per election in Admin -> Elections)
PUBLISH_REPLAY_ENABLED=true      # on Publish, replay every ballot from the first at the election's pace
LOG_LEVEL=INFO
